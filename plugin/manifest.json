{
  "manifestVersion": 6,
  "id": "dev.graham.photoshop-banding",
  "name": "Negative Band Correction",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "25.0.0", "data": { "apiVersion": 2 } },
  "addon": { "name": "banding-v010.uxpaddon" },
  "icons": [{ "width": 48, "height": 48, "path": "icons/banding-48.png", "scale": [1, 2] }],
  "entrypoints": [{
    "type": "panel", "id": "banding", "label": { "default": "Negative Band Correction" },
    "icons": [{ "width": 23, "height": 23, "path": "icons/banding-23.png", "scale": [1, 2], "theme": ["all"] }],
    "minimumSize": { "width": 380, "height": 680 },
    "preferredDockedSize": { "width": 400, "height": 720 },
    "preferredFloatingSize": { "width": 420, "height": 740 }
  }],
  "requiredPermissions": {
    "localFileSystem": "request",
    "enableAddon": true
  }
}
